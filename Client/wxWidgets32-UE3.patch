 #include "wx/windowid.h"
 
+#ifdef __WXMSW__
+// UE3 supplies these callbacks to integrate native engine windows and to
+// report exceptions raised inside Windows callbacks.
+#include "wx/msw/wrapwin.h"
+class WXDLLIMPEXP_CORE wxUnrealCallbacks
+{
+public:
+    virtual ~wxUnrealCallbacks() {}
+    virtual bool IsUnrealWindowHandle(HWND hwnd) const = 0;
+    virtual bool IsRequestingExit() const = 0;
+    virtual void SetRequestingExit(bool requestingExit) = 0;
+    virtual int WndProcExceptionFilter(LPEXCEPTION_POINTERS info) = 0;
+    virtual void WndProcUnhandledExceptionCallback() = 0;
+};
+WXDLLIMPEXP_CORE void SetUnrealCallbacks(wxUnrealCallbacks* callbacks);
+WXDLLIMPEXP_CORE wxUnrealCallbacks* GetUnrealCallbacks();
+#endif
+
 #if wxUSE_PALETTE
     #include "wx/palette.h"
 #endif // wxUSE_PALETTE
