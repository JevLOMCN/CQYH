diff --git a/include/wx/msw/listctrl.h b/include/wx/msw/listctrl.h
index f796132..606d2eb 100644
--- a/include/wx/msw/listctrl.h
+++ b/include/wx/msw/listctrl.h
@@ -342,6 +342,32 @@ public:
     // data is arbitrary data to be passed to the sort function.
     bool SortItems(wxListCtrlCompare fn, wxIntPtr data);
 
+    // UE3 and FaceFX used unsigned pointer-sized callback arguments in their
+    // wxWidgets 2.8 build. Adapt them without calling a mismatched function
+    // pointer. Native MSW list sorting is synchronous, so the context remains
+    // valid for the duration of SortItems().
+    #if defined(_WIN64)
+    typedef wxUIntPtr UE3SortValue;
+#else
+    typedef unsigned int UE3SortValue;
+#endif
+    typedef int (wxCALLBACK *UE3ListCtrlCompare)(UE3SortValue, UE3SortValue, UE3SortValue);
+    bool SortItems(UE3ListCtrlCompare fn, UE3SortValue data)
+    {
+        UE3SortContext context = { fn, data };
+        return SortItems(&wxListCtrl::UE3SortThunk, reinterpret_cast<wxIntPtr>(&context));
+    }
+
+private:
+    struct UE3SortContext { UE3ListCtrlCompare fn; UE3SortValue data; };
+    static int wxCALLBACK UE3SortThunk(wxIntPtr a, wxIntPtr b, wxIntPtr opaque)
+    {
+        UE3SortContext* context = reinterpret_cast<UE3SortContext*>(opaque);
+        return context->fn(static_cast<UE3SortValue>(a), static_cast<UE3SortValue>(b), context->data);
+    }
+
+public:
+
     // IMPLEMENTATION
     virtual bool MSWCommand(WXUINT param, WXWORD id) wxOVERRIDE;
     virtual bool MSWOnNotify(int idCtrl, WXLPARAM lParam, WXLPARAM *result) wxOVERRIDE;
