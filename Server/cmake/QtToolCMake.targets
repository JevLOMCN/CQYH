<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Preserve the per-tool projects for navigation, but use the maintained CMake
       target for build/generation. In particular, never regenerate tracked UI
       headers with the old Qt4/Qt5.3 custom commands. -->
  <!-- Clean this target only; never clean its shared libraries or the source tree. -->
  <!-- Compatibility adapter; all tool projects share ToolCMake.targets. -->
  <PropertyGroup>
    <CQYHCMakeTarget Condition="'$(CQYHCMakeTarget)' == ''">$(CQYHQtToolTarget)</CQYHCMakeTarget>
    <CQYHCMakeRequiresQt>true</CQYHCMakeRequiresQt>
  </PropertyGroup>
  <Import Project="ToolCMake.targets" />
  <Target Name="CQYHQtValidate" DependsOnTargets="CQYHToolValidate" />
  <Target Name="CQYHQtBuild" DependsOnTargets="CQYHToolValidate;CQYHToolBuild" />
  <Target Name="CQYHQtClean" DependsOnTargets="CQYHToolValidate;CQYHToolClean" />
</Project>
