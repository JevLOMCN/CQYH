cmake_minimum_required(VERSION 3.25)
execute_process(COMMAND "${ACCOUNT_TEST}" "${WORK_DIR}/analysis"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Account fixture failed: ${result}\n${stdout}\n${stderr}")
endif()
message(STATUS "${stdout}")
set(expected "Session : a, UserName : Alpha Found!\nSessionID : b in , UserName : Beta in dl file, not found in db file?\nCan not find UserName : Missing in db login file?\nSessionID : 0 in , UserName : Missing in dl file, not found in db file?\n")
file(MAKE_DIRECTORY "${WORK_DIR}/cli/work")
foreach(name IN ITEMS account_logout "测试")
    set(root "${WORK_DIR}/cli/${name}")
    file(MAKE_DIRECTORY "${root}/db_file" "${root}/dl_file")
    file(WRITE "${root}/db_file/session.txt" "a\nb\n")
    file(WRITE "${root}/db_file/user.txt" "Alpha\nBeta\n")
    file(WRITE "${root}/db_file/logout.txt" "a\n")
    file(WRITE "${root}/dl_file/AccountLogin.txt" "Alpha\nBeta\nMissing\n")
    execute_process(COMMAND "${ACCOUNT_TOOL}" --input "${root}" RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    string(REPLACE "\r\n" "\n" stdout "${stdout}")
    if(NOT "${result}" STREQUAL "0" OR NOT stdout STREQUAL expected OR NOT stderr STREQUAL "")
        message(FATAL_ERROR "Account CLI input path failed: ${result}\n${stdout}\n${stderr}")
    endif()
endforeach()
execute_process(COMMAND "${ACCOUNT_TOOL}" WORKING_DIRECTORY "${WORK_DIR}/cli/work"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
string(REPLACE "\r\n" "\n" stdout "${stdout}")
if(NOT "${result}" STREQUAL "0" OR NOT stdout STREQUAL expected OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Legacy default input path failed: ${result}\n${stdout}\n${stderr}")
endif()
execute_process(COMMAND "${ACCOUNT_TOOL}" --help RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT "${result}" STREQUAL "0" OR NOT stdout MATCHES "Usage:" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Help failed: ${result}\n${stdout}\n${stderr}")
endif()
execute_process(COMMAND "${ACCOUNT_TOOL}" --invalid RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT "${result}" STREQUAL "1" OR NOT stderr MATCHES "Usage:")
    message(FATAL_ERROR "Invalid option did not fail: ${result}\n${stdout}\n${stderr}")
endif()
execute_process(COMMAND "${ACCOUNT_TOOL}" --input "${WORK_DIR}/does-not-exist"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT "${result}" STREQUAL "1" OR NOT stdout STREQUAL "" OR NOT stderr MATCHES "session.txt")
    message(FATAL_ERROR "Missing input did not fail clearly: ${result}\n${stdout}\n${stderr}")
endif()
