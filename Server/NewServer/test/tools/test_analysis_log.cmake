cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK_DIR}/errors" "${WORK_DIR}/network" "${WORK_DIR}/empty")
execute_process(COMMAND "${ANALYSIS_TEST}" "${WORK_DIR}/unit"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Analysis parser/worker checks failed: ${result}\n${stdout}\n${stderr}")
endif()
message(STATUS "${stdout}")
foreach(mode IN ITEMS errors network)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/fixtures/analysis-${mode}.txt" "${WORK_DIR}/${mode}/records.log" COPYONLY)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/fixtures/analysis-${mode}.expected" expected)
    string(REPLACE "\r\n" "\n" expected "${expected}")
    if(mode STREQUAL "errors")
        set(number 1)
    else()
        set(number 2)
    endif()
    foreach(ending IN ITEMS crlf lf unterminated)
        file(READ "${CMAKE_CURRENT_LIST_DIR}/fixtures/analysis-${mode}.txt" contents)
        if(NOT ending STREQUAL "crlf")
            string(REPLACE "\r\n" "\n" contents "${contents}")
            if(ending STREQUAL "unterminated")
                string(REGEX REPLACE "\n$" "" contents "${contents}")
            endif()
        endif()
        if(ending STREQUAL "crlf")
            configure_file("${CMAKE_CURRENT_LIST_DIR}/fixtures/analysis-${mode}.txt" "${WORK_DIR}/${mode}/records.log" COPYONLY)
        else()
            file(CONFIGURE OUTPUT "${WORK_DIR}/${mode}/records.log" CONTENT "${contents}" @ONLY NEWLINE_STYLE UNIX)
        endif()
        execute_process(COMMAND "${ANALYSIS_TOOL}" "${WORK_DIR}/${mode}" ${number}
            RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
        if(NOT "${result}" STREQUAL "0" OR NOT stderr STREQUAL "" OR NOT stdout STREQUAL expected)
            message(FATAL_ERROR "${mode}/${ending}: original parser output changed: ${result}\n${stdout}\n${stderr}")
        endif()
    endforeach()
endforeach()

# More files than the caller's outstanding-work window exercise drain/backpressure.
file(MAKE_DIRECTORY "${WORK_DIR}/many")
foreach(index RANGE 1 80)
    file(WRITE "${WORK_DIR}/many/${index}.LOG" "2020-01-01 12:00:00.000\t[E] [00000001] repeated\n")
endforeach()
file(WRITE "${WORK_DIR}/many/zero.log" "")
file(WRITE "${WORK_DIR}/many/.skip.log" "2020-01-01 12:00:00.000\t[E] [00000001] ignored\n")
execute_process(COMMAND "${ANALYSIS_TOOL}" "${WORK_DIR}/many" 1 RESULT_VARIABLE result
    OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
if(NOT "${result}" STREQUAL "0" OR NOT stdout STREQUAL "repeated\t80\n" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Multi-file results were lost or filters changed: ${result} ${stdout} ${stderr}")
endif()
execute_process(COMMAND "${ANALYSIS_TOOL}" "${WORK_DIR}/empty" 1
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT "${result}" STREQUAL "0" OR NOT stdout STREQUAL "" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Empty directory handling failed")
endif()
foreach(args IN ITEMS "absent;1" "empty;invalid" "empty;1extra" "empty;3")
    execute_process(COMMAND "${ANALYSIS_TOOL}" ${args} WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if("${result}" STREQUAL "0" OR stderr STREQUAL "")
        message(FATAL_ERROR "Invalid input must fail: ${args}")
    endif()
endforeach()
