cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK_DIR}")
execute_process(COMMAND "${PAK_TEST}" "${WORK_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "PAK test failed: ${result}\n${stdout}\n${stderr}")
endif()
foreach(variant IN ITEMS named raw plain)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/fixtures/${variant}.pak" expected)
    file(SHA256 "${WORK_DIR}/${variant}.pak" actual)
    if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "${variant}: archive bytes differ from the pre-migration fixture")
    endif()
endforeach()

function(run_pak success)
    execute_process(COMMAND "${PAK_TOOL}" ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if(success AND NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "PAK command ${ARGN} failed: ${result}\n${stdout}\n${stderr}")
    elseif(NOT success AND "${result}" STREQUAL "0")
        message(FATAL_ERROR "PAK command ${ARGN} incorrectly reported success")
    endif()
endfunction()

# Inspecting and extracting the original fixtures must leave their bytes alone.
foreach(variant IN ITEMS named raw plain)
    run_pak(TRUE list "${variant}.pak")
    run_pak(TRUE listmd5 "${variant}.pak")
    run_pak(TRUE verify "${variant}.pak")
    run_pak(TRUE extract "${variant}.pak" "extract ${variant}")
    file(SHA256 "${WORK_DIR}/${variant}.pak" actual)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/fixtures/${variant}.pak" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Inspection rewrote the ${variant} archive")
    endif()
endforeach()

file(MAKE_DIRECTORY "${WORK_DIR}/input data/sub")
file(REMOVE "${WORK_DIR}/input data/new.txt")
file(WRITE "${WORK_DIR}/input data/a" "initial text")
file(WRITE "${WORK_DIR}/input data/removed.txt" "deleted in patch")
file(WRITE "${WORK_DIR}/input data/sub/empty" "")
file(WRITE "${WORK_DIR}/input data/ignored.log" "skip this extension")
file(WRITE "${WORK_DIR}/input data/.hidden" "skip dot files")
run_pak(TRUE create "input data")
configure_file("${WORK_DIR}/input data.pak" "${WORK_DIR}/original.pak" COPYONLY)
file(WRITE "${WORK_DIR}/input data/a" "updated text")
file(REMOVE "${WORK_DIR}/input data/removed.txt")
file(WRITE "${WORK_DIR}/input data/new.txt" "new in patch")
run_pak(TRUE create "input data")
run_pak(TRUE patch original.pak "input data.pak" changes.pak)
run_pak(TRUE append original.pak changes.pak)
run_pak(TRUE verify "input data" original.pak)
run_pak(TRUE extract original.pak "patched output")
file(READ "${WORK_DIR}/patched output/input data/a" updated)
file(READ "${WORK_DIR}/patched output/input data/new.txt" added)
if(NOT updated STREQUAL "updated text" OR NOT added STREQUAL "new in patch" OR
    EXISTS "${WORK_DIR}/patched output/input data/removed.txt" OR
    EXISTS "${WORK_DIR}/patched output/input data/ignored.log" OR
    EXISTS "${WORK_DIR}/patched output/input data/.hidden")
    message(FATAL_ERROR "Patch/extraction contents, deletion or filters changed")
endif()
file(WRITE "${WORK_DIR}/input data/a" "damaged text")
run_pak(FALSE verify "input data" original.pak)
run_pak(TRUE createraw "input data")
run_pak(TRUE verify "input data.pak")
run_pak(FALSE list absent.pak)
run_pak(FALSE verify malformed.pak)
run_pak(FALSE append original.pak original.pak)
run_pak(FALSE patch original.pak original.pak original.pak)
run_pak(FALSE unknown original.pak)
run_pak(FALSE list original.pak extra)
run_pak(FALSE)
message(STATUS "${stdout}")
