cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK_DIR}")
execute_process(COMMAND "${COMMON_TEST}" "${WORK_DIR}" RESULT_VARIABLE result
    OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
if(NOT "${result}" STREQUAL "0" OR NOT stderr STREQUAL "" OR
    NOT stdout MATCHES "start: 0, generate: 0, success: 0, failed: 1 include timeout: 0")
    message(FATAL_ERROR "Common parser/state checks failed: ${result}\n${stdout}\n${stderr}")
endif()
message(STATUS "${stdout}")

set(rows "2020-01-01 12:00:00\tstart\tAlice\n2020-01-01 12:00:00\tgenerate\tAlice\n2020-01-01 12:00:01\tsuccess\tAlice\n2020-01-01 12:00:00\tgenerate\tBob\n2020-01-01 12:10:00\tfailed\tBob\n2020-01-01 12:10:01\tkick\tCarol")
set(expected "process end, start: 1, generate: 2, success: 1, failed: 2 include timeout: 1")
foreach(ending IN ITEMS lf crlf unterminated)
    set(contents "${rows}")
    if(ending STREQUAL "crlf")
        string(REPLACE "\n" "\r\n" contents "${rows}\n")
    elseif(ending STREQUAL "lf")
        string(APPEND contents "\n")
    endif()
    if(ending STREQUAL "crlf")
        file(CONFIGURE OUTPUT "${WORK_DIR}/events.log" CONTENT "${contents}" @ONLY NEWLINE_STYLE DOS)
    else()
        file(CONFIGURE OUTPUT "${WORK_DIR}/events.log" CONTENT "${contents}" @ONLY NEWLINE_STYLE UNIX)
    endif()
    execute_process(COMMAND "${COMMON_LOG}" "${WORK_DIR}/events.log"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if(NOT "${result}" STREQUAL "0" OR NOT stdout STREQUAL expected OR NOT stderr STREQUAL "")
        message(FATAL_ERROR "${ending}: report differs from baseline: ${result}\n${stdout}\n${stderr}")
    endif()
endforeach()

file(WRITE "${WORK_DIR}/events.log" "2020-01-01 23:55:00\tgenerate\tAlice\n2020-01-02 00:05:00\tfailed\tAlice")
execute_process(COMMAND "${COMMON_LOG}" "${WORK_DIR}/events.log"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT "${result}" STREQUAL "0" OR NOT stdout MATCHES "include timeout: 1")
    message(FATAL_ERROR "Timeout across midnight was lost: ${stdout} ${stderr}")
endif()
foreach(invalid IN ITEMS "bad time\tgenerate\tAlice" "2020-01-01 00:00:00\tgenerate" "2020-01-01 00:00:00\tgenerate\t")
    file(WRITE "${WORK_DIR}/events.log" "${invalid}")
    execute_process(COMMAND "${COMMON_LOG}" "${WORK_DIR}/events.log"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if("${result}" STREQUAL "0" OR stderr STREQUAL "")
        message(FATAL_ERROR "Malformed records must fail with a diagnostic")
    endif()
endforeach()
execute_process(COMMAND "${COMMON_LOG}" "${WORK_DIR}/absent.log" RESULT_VARIABLE result ERROR_VARIABLE stderr TIMEOUT 10)
if("${result}" STREQUAL "0" OR stderr STREQUAL "")
    message(FATAL_ERROR "Missing input must fail")
endif()
