cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK_DIR}")
set(header "${WORK_DIR}/version header.h")
set(model "${WORK_DIR}/packaging template.model")
set(output "${WORK_DIR}/result.bat")

function(run_label name success)
    execute_process(COMMAND "${LABEL_TOOL}" ${ARGN}
        WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if(success)
        if(NOT "${result}" STREQUAL "0" OR NOT stderr STREQUAL "" OR NOT stdout MATCHES "OK!")
            message(FATAL_ERROR "${name}: result=${result}, stderr=${stderr}")
        endif()
    elseif("${result}" STREQUAL "0" OR stderr STREQUAL "")
        message(FATAL_ERROR "${name}: expected a failing exit and diagnostic, got ${result}")
    endif()
endfunction()

file(WRITE "${header}" "#define GM_MAJOR_VERSION (17)\r\n#define GM_MINOR_VERSION (1)\r\n")
foreach(ending IN ITEMS "LF" "CRLF")
    set(newline "\n")
    if(ending STREQUAL "CRLF")
        set(newline "\r\n")
    endif()
    set(template "Set VersionName=gmtool_${newline}echo %VersionName%_s${newline}")
    if(ending STREQUAL "CRLF")
        file(CONFIGURE OUTPUT "${model}" CONTENT "${template}" @ONLY NEWLINE_STYLE DOS)
    else()
        file(CONFIGURE OUTPUT "${model}" CONTENT "${template}" @ONLY NEWLINE_STYLE UNIX)
    endif()
    run_label(${ending} TRUE "${header}" "${model}" "${output}")
    string(REPLACE "gmtool_" "gmtool_17.1" expected "${template}")
    if(ending STREQUAL "CRLF")
        file(CONFIGURE OUTPUT "${WORK_DIR}/expected.bat" CONTENT "${expected}" @ONLY NEWLINE_STYLE DOS)
    else()
        file(CONFIGURE OUTPUT "${WORK_DIR}/expected.bat" CONTENT "${expected}" @ONLY NEWLINE_STYLE UNIX)
    endif()
    file(SHA256 "${output}" actual_hash)
    file(SHA256 "${WORK_DIR}/expected.bat" expected_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "${ending}: output bytes, line endings or first-marker insertion changed")
    endif()
endforeach()

# The real shipped template keeps every command, byte and subsequent underscore.
configure_file("${SERVER}/NewServer/tools/gmtool/bin/pak-version.model" "${model}" COPYONLY)
file(READ "${model}" template HEX)
string(FIND "${template}" "5f" marker)
math(EXPR insertion "${marker} + 2")
string(SUBSTRING "${template}" 0 ${insertion} prefix)
string(SUBSTRING "${template}" ${insertion} -1 suffix)
set(expected_hex "${prefix}31372e31${suffix}")
run_label(shipped TRUE "${header}" "${model}" "${output}")
file(READ "${output}" actual_hex HEX)
if(NOT actual_hex STREQUAL expected_hex)
    message(FATAL_ERROR "Shipped packaging template changed beyond the version insertion")
endif()

string(REPEAT "header padding " 2000 padding)
file(WRITE "${header}" "// ${padding}\n#define GM_MAJOR_VERSION (17)\n#define GM_MINOR_VERSION (1)\n")
string(REPEAT "x" 9000000 large_template)
file(WRITE "${model}" "version_${large_template}")
file(WRITE "${WORK_DIR}/large-expected.bat" "version_17.1${large_template}")
run_label(large_inputs TRUE "${header}" "${model}" "${output}")
file(SHA256 "${WORK_DIR}/large-expected.bat" expected_hash)
file(SHA256 "${output}" actual_hash)
if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Inputs larger than the old fixed buffers changed output")
endif()
file(WRITE "${model}" "version_")

# Validate before opening the output, so bad inputs leave an existing file alone.
foreach(invalid IN ITEMS missing empty truncated negative overflow suffix wrong_name)
    set(definition "")
    if(invalid STREQUAL "truncated")
        set(definition "#define GM_MAJOR_VERSION (17")
    elseif(invalid STREQUAL "negative")
        set(definition "#define GM_MAJOR_VERSION (-1)")
    elseif(invalid STREQUAL "overflow")
        set(definition "#define GM_MAJOR_VERSION (99999999999999999999999999)")
    elseif(invalid STREQUAL "suffix")
        set(definition "#define GM_MAJOR_VERSION (17oops)")
    elseif(invalid STREQUAL "wrong_name")
        set(definition "// GM_MAJOR_VERSION (99)\n#define GM_MAJOR_VERSION_EXTRA (17)")
    elseif(invalid STREQUAL "empty")
        set(definition "#define GM_MAJOR_VERSION ()")
    endif()
    file(WRITE "${header}" "${definition}\n#define GM_MINOR_VERSION (1)\n")
    file(WRITE "${output}" "preserve existing output")
    run_label(${invalid} FALSE "${header}" "${model}" "${output}")
    file(READ "${output}" preserved)
    if(NOT preserved STREQUAL "preserve existing output")
        message(FATAL_ERROR "${invalid}: bad input truncated the output")
    endif()
endforeach()

file(WRITE "${header}" "# define GM_MAJOR_VERSION 0 // valid initial major\n#define GM_MINOR_VERSION (0)\n")
file(WRITE "${model}" "version_")
run_label(zero TRUE "${header}" "${model}" "${output}")
file(READ "${output}" zero)
if(NOT zero STREQUAL "version_0.0")
    message(FATAL_ERROR "Zero versions must be represented rather than silently skipped")
endif()
run_label(missing_header FALSE "${WORK_DIR}/absent.h" "${model}" "${output}")
run_label(missing_template FALSE "${header}" "${WORK_DIR}/absent.model" "${output}")
run_label(directory_output FALSE "${header}" "${model}" "${WORK_DIR}")
run_label(same_input_output FALSE "${header}" "${model}" "${model}")
run_label(same_header_output FALSE "${header}" "${model}" "${header}")
file(WRITE "${model}" "no marker")
run_label(missing_marker FALSE "${header}" "${model}" "${output}")
run_label(bad_arguments FALSE extra)

# Keep the existing no-argument invocation usable from the packaging directory.
file(MAKE_DIRECTORY "${WORK_DIR}/inc/gm" "${WORK_DIR}/a/b/c")
file(WRITE "${WORK_DIR}/inc/gm/gm_version.h" "#define GM_MAJOR_VERSION (17)\n#define GM_MINOR_VERSION (1)\n")
file(WRITE "${WORK_DIR}/a/b/c/pak-version.model" "version_")
execute_process(COMMAND "${LABEL_TOOL}" WORKING_DIRECTORY "${WORK_DIR}/a/b/c"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
file(READ "${WORK_DIR}/a/b/c/pak.bat" default_output)
if(NOT "${result}" STREQUAL "0" OR NOT default_output STREQUAL "version_17.1")
    message(FATAL_ERROR "Default packaging invocation failed: ${result} ${stderr}")
endif()
message(STATUS "Version label: template byte compatibility and invalid-input checks passed")
