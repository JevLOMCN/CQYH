cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK_DIR}")
execute_process(COMMAND "${ROLE_TEST}" "${WORK_DIR}/unit"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 40)
if(NOT "${result}" STREQUAL "0" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Role log unit checks failed: ${result}\n${stdout}\n${stderr}")
endif()
string(REGEX MATCH "[0-9]+ allocation failure points, [0-9]+ successful attempts" allocation_report "${stdout}")
string(REGEX MATCH "[0-9]+ role log checks passed" unit_report "${stdout}")
message(STATUS "${allocation_report}; ${unit_report}")

file(READ "${CMAKE_CURRENT_LIST_DIR}/fixtures/role-log-cases.json" cases)
string(JSON count LENGTH "${cases}")
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON name GET "${cases}" ${index} name)
    set(first "${WORK_DIR}/${name}")
    set(second "${WORK_DIR}/${name}-second")
    file(MAKE_DIRECTORY "${first}")
    foreach(kind IN ITEMS Money gmmoney RoleLogout_Basic)
        string(JSON contents GET "${cases}" ${index} data ${kind})
        file(CONFIGURE OUTPUT "${first}/${kind}_2020_01_01.txt" CONTENT "${contents}" @ONLY NEWLINE_STYLE UNIX)
    endforeach()
    string(JSON second_type TYPE "${cases}" ${index} second)
    set(extra)
    if(NOT second_type STREQUAL "NULL")
        file(MAKE_DIRECTORY "${second}")
        foreach(kind IN ITEMS Money gmmoney RoleLogout_Basic)
            string(JSON contents GET "${cases}" ${index} second ${kind})
            file(CONFIGURE OUTPUT "${second}/${kind}_2020_01_02.txt" CONTENT "${contents}" @ONLY NEWLINE_STYLE UNIX)
        endforeach()
        set(extra "${second}" 2020_01_02)
    endif()
    execute_process(COMMAND "${ROLE_TEST}" "${first}" 2020_01_01 ${extra}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    string(JSON errors GET "${cases}" ${index} expected errors)
    string(JSON discarded GET "${cases}" ${index} expected discarded)
    string(JSON total GET "${cases}" ${index} expected total)
    if(NOT "${result}" STREQUAL "0" OR NOT stdout MATCHES "ROLE_SUMMARY ${errors} ${discarded} ${total}\n" OR NOT stderr STREQUAL "")
        message(FATAL_ERROR "${name}: original reconciliation result changed: ${result}\n${stdout}\n${stderr}")
    endif()
    string(REGEX MATCHALL "ROLE_DETAIL [^\r\n]*" actual_details "${stdout}")
    string(JSON detail_count LENGTH "${cases}" ${index} details)
    list(LENGTH actual_details actual_count)
    if(NOT actual_count EQUAL detail_count)
        message(FATAL_ERROR "${name}: mismatch detail count changed")
    endif()
    if(detail_count GREATER 0)
        math(EXPR last_detail "${detail_count} - 1")
        foreach(detail_index RANGE 0 ${last_detail})
            string(JSON expected GET "${cases}" ${index} details ${detail_index})
            list(GET actual_details ${detail_index} actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "${name}: mismatch amounts/timestamps changed\n${actual}\n${expected}")
            endif()
        endforeach()
    endif()
endforeach()
message(STATUS "${count} original reconciliation results matched")

# Exercise the actual entry point and its logging/dump lifetime in a private directory.
foreach(name IN ITEMS balanced mismatch two-days)
    set(extra)
    if(name STREQUAL "two-days")
        set(extra "${WORK_DIR}/${name}-second" 2020_01_02)
    endif()
    execute_process(COMMAND "${ROLE_TOOL}" "${WORK_DIR}/${name}" 2020_01_01 ${extra}
        WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
    if(NOT "${result}" STREQUAL "0" OR NOT stdout MATCHES "log file parse complete.")
        message(FATAL_ERROR "Role tool CLI failed: ${result}\n${stdout}\n${stderr}")
    endif()
endforeach()
execute_process(COMMAND "${ROLE_TOOL}" "${WORK_DIR}/absent" 2020_01_01
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
if("${result}" STREQUAL "0")
    message(FATAL_ERROR "Missing files must return a failed exit")
endif()
execute_process(COMMAND "${ROLE_TOOL}" "${WORK_DIR}/balanced" invalid
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
if("${result}" STREQUAL "0")
    message(FATAL_ERROR "Invalid arguments must return a failed exit")
endif()
