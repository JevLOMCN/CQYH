cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK_DIR}")
set(header "${WORK_DIR}/error definitions.h")
set(input "${WORK_DIR}/existing map.txt")
set(output "${WORK_DIR}/new map.txt")
set(prefix "MMOErrorInfo.ERROR_CODE_DEF.")
file(WRITE "${header}" "enum ERROR_CODE_DEF\n{\nerrSuccess = 0, ///< Success\nerrLoginBegin = 0x100,\nerrNew, ///< New text\nerrEmpty, ///<\nerrNoComment,\nerrLoginEnd,\nerrGMSpecial,\n};\n")
set(valid_header "enum ERROR_CODE_DEF\n{\nerrSuccess = 0, ///< Success\nerrLoginBegin = 0x100,\nerrNew, ///< New text\nerrEmpty, ///<\nerrNoComment,\nerrLoginEnd,\nerrGMSpecial,\n};\n")

function(run_map name success)
    execute_process(COMMAND "${MAP_TOOL}" ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if(success)
        if(NOT "${result}" STREQUAL "0" OR NOT stderr STREQUAL "")
            message(FATAL_ERROR "${name}: result=${result}, stderr=${stderr}")
        endif()
    elseif("${result}" STREQUAL "0" OR stderr STREQUAL "")
        message(FATAL_ERROR "${name}: expected failure and diagnostic, got ${result}")
    endif()
    set(last_stdout "${stdout}" PARENT_SCOPE)
endfunction()

set(existing "${prefix}errSuccess\tTranslated\tTranslated\t0\t0\n${prefix}errRemoved\tGone\tGone\t0\t0\n${prefix}errRemoved\tGone\tGone\t0\t0")
set(expected "${prefix}errRemoved\tinvalid enum value, please erase it\tinvalid enum value, please erase it\t0\t0\n${prefix}errNew\tNew\tNew\t0\t0\n${prefix}errEmpty\t\t\t0\t0\n${prefix}errNoComment\tno comment\tno comment\t0\t0\n")
string(HEX "${expected}" expected_hex)
string(REGEX REPLACE "(..)" "\\100" expected_hex "${expected_hex}")
set(expected_hex "fffe${expected_hex}")
foreach(encoding IN ITEMS utf8 utf16le utf16le_no_bom)
    if(encoding STREQUAL "utf8")
        file(WRITE "${input}" "${existing}")
    else()
        configure_file("${CMAKE_CURRENT_LIST_DIR}/fixtures/${encoding}.txt" "${input}" COPYONLY)
    endif()
    run_map(${encoding} TRUE "${header}" "${input}" "${output}")
    file(READ "${output}" actual_hex HEX)
    if(NOT actual_hex STREQUAL expected_hex OR NOT last_stdout MATCHES "1 old error code.s., 3 new error code.s.")
        message(FATAL_ERROR "${encoding}: report content, order, BOM, duplicate handling or counters changed: ${last_stdout}")
    endif()
endforeach()

# Validate non-ASCII comments and surrogate pairs through the native UTF boundary.
file(WRITE "${header}" "enum ERROR_CODE_DEF\n{\nerrUnicode, ///< 中文😀\n};\n")
file(WRITE "${input}" "")
run_map(unicode TRUE "${header}" "${input}" "${output}")
file(READ "${output}" unicode_hex HEX)
if(NOT unicode_hex MATCHES "2d4e87653dd800de09002d4e87653dd800de")
    message(FATAL_ERROR "UTF-8 comments did not round-trip to UTF-16LE")
endif()

foreach(invalid IN ITEMS missing_enum unterminated duplicate bad_utf8 bad_utf16)
    file(WRITE "${header}" "${valid_header}")
    file(WRITE "${input}" "")
    if(invalid STREQUAL "missing_enum")
        file(WRITE "${header}" "enum SomethingElse { errOther };\n")
    elseif(invalid STREQUAL "unterminated")
        file(WRITE "${header}" "enum ERROR_CODE_DEF\n{\nerrOther,\n")
    elseif(invalid STREQUAL "duplicate")
        file(WRITE "${header}" "enum ERROR_CODE_DEF\n{\nerrOther,\nerrOther,\n};\n")
    elseif(invalid STREQUAL "bad_utf8")
        string(ASCII 192 175 invalid_utf8)
        file(WRITE "${input}" "${invalid_utf8}")
    else()
        configure_file("${CMAKE_CURRENT_LIST_DIR}/fixtures/truncated_utf16le.txt" "${input}" COPYONLY)
    endif()
    file(WRITE "${output}" "preserve existing output")
    run_map(${invalid} FALSE "${header}" "${input}" "${output}")
    file(READ "${output}" preserved)
    if(NOT preserved STREQUAL "preserve existing output")
        message(FATAL_ERROR "${invalid}: invalid input truncated the output")
    endif()
endforeach()
file(WRITE "${header}" "${valid_header}")
file(WRITE "${input}" "")
run_map(missing_file FALSE "${header}" "${WORK_DIR}/absent.txt" "${output}")
run_map(directory_output FALSE "${header}" "${input}" "${WORK_DIR}")
run_map(same_output FALSE "${header}" "${input}" "${input}")
run_map(same_header FALSE "${header}" "${input}" "${header}")
run_map(arguments FALSE extra)

# Process the complete shipped enum and feed its UTF-16LE output back as the map.
run_map(shipped TRUE "${SERVER}/Common/define/error_def.h" "${input}" "${output}")
configure_file("${output}" "${input}" COPYONLY)
run_map(all_present TRUE "${SERVER}/Common/define/error_def.h" "${input}" "${output}")
file(READ "${output}" empty_report HEX)
if(NOT empty_report STREQUAL "fffe" OR NOT last_stdout MATCHES "0 old error code.s., 0 new error code.s.")
    message(FATAL_ERROR "Existing entries were not matched against the full shipped enum")
endif()
message(STATUS "String map: report, Unicode, duplicate, shipped-enum and failure checks passed")
