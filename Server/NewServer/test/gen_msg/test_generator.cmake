cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK_DIR}")

function(run_generator name expect_success)
    execute_process(COMMAND "${GENERATOR}" ${ARGN}
        WORKING_DIRECTORY "${WORK_DIR}"
        OUTPUT_FILE "${WORK_DIR}/${name}.out"
        ERROR_FILE "${WORK_DIR}/${name}.err"
        RESULT_VARIABLE result TIMEOUT 30)
    file(SIZE "${WORK_DIR}/${name}.out" output_size)
    file(READ "${WORK_DIR}/${name}.err" diagnostic)
    if(expect_success)
        if(NOT "${result}" STREQUAL "0" OR output_size EQUAL 0 OR NOT diagnostic STREQUAL "")
            message(FATAL_ERROR "${name}: result=${result}, bytes=${output_size}, stderr=${diagnostic}")
        endif()
    elseif("${result}" STREQUAL "0" OR NOT output_size EQUAL 0 OR diagnostic STREQUAL "")
        message(FATAL_ERROR "${name}: failure must report a nonzero exit, a diagnostic and no generated output")
    endif()
endfunction()

foreach(mode IN ITEMS enum msg errcode btnode btevent)
    run_generator(${mode} TRUE ${mode})
endforeach()
run_generator(no_mode FALSE)
run_generator(unknown_mode FALSE invalid)
run_generator(extra_argument FALSE msg unexpected)
run_generator(missing_input FALSE btnode "${WORK_DIR}/missing-input.h")
run_generator(directory_input FALSE btnode "${WORK_DIR}")

configure_file("${SERVER}/NewServer/inc/gameworld/bt_action.h" "${WORK_DIR}/action source.h" COPYONLY)
configure_file("${SERVER}/NewServer/inc/gameworld/bt_event.h" "${WORK_DIR}/event source.h" COPYONLY)
run_generator(explicit_node TRUE btnode "${WORK_DIR}/action source.h")
run_generator(explicit_event TRUE btevent "${WORK_DIR}/event source.h")
foreach(pair IN ITEMS "btnode;explicit_node" "btevent;explicit_event")
    list(GET pair 0 default_name)
    list(GET pair 1 explicit_name)
    file(SHA256 "${WORK_DIR}/${default_name}.out" default_hash)
    file(SHA256 "${WORK_DIR}/${explicit_name}.out" explicit_hash)
    if(NOT default_hash STREQUAL explicit_hash)
        message(FATAL_ERROR "Explicit source path changed ${default_name} output")
    endif()
endforeach()

# A Lua parse error must survive the C++ entry point as a failed command.
file(WRITE "${WORK_DIR}/invalid-source.h" "enum BT_ACTION_TYPE\n///< @param Value invalid annotation without a node\n")
run_generator(invalid_source FALSE btnode "${WORK_DIR}/invalid-source.h")

file(READ "${WORK_DIR}/btnode.out" node_output)
file(READ "${WORK_DIR}/btevent.out" event_output)
file(READ "${WORK_DIR}/errcode.out" error_output)
if(NOT node_output MATCHES "\\[BTNodeTypeList\\]" OR
   NOT event_output MATCHES "\\[BTEventTypeList\\]" OR
   NOT error_output MATCHES "g_szErrorCodeNameList\\[\\]")
    message(FATAL_ERROR "A generator mode emitted incomplete output")
endif()

# Check every slot, name and size against the recorded pre-change generator.
file(STRINGS "${WORK_DIR}/msg.out" output_lines)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/packet_sizes.txt" expected REGEX "^(C2S|S2C) ")
file(READ "${SERVER}/NewServer/test/protocol_layouts/windows_x64_layouts.inc" layouts)
set(direction "")
set(actual_C2S "")
set(actual_S2C "")
foreach(line IN LISTS output_lines)
    if(line MATCHES "^INT32 g_n(C2S|S2C)MessageSize\\[\\] = ")
        set(direction "${CMAKE_MATCH_1}")
        set(slot 0)
    elseif(NOT direction STREQUAL "" AND line MATCHES "^};")
        if(NOT slot EQUAL 1024)
            message(FATAL_ERROR "${direction}: expected 1024 slots, found ${slot}")
        endif()
        set(direction "")
    elseif(NOT direction STREQUAL "" AND line MATCHES "^[ \t]*(-?[0-9]+),")
        set(size "${CMAKE_MATCH_1}")
        if(NOT size EQUAL 0)
            if(NOT line MATCHES "//[ \t]*([0-9]+)[ \t]+([A-Z0-9_]+)")
                message(FATAL_ERROR "Missing packet identity: ${line}")
            endif()
            set(id "${CMAKE_MATCH_1}")
            set(name "${CMAKE_MATCH_2}")
            if(NOT id EQUAL slot)
                message(FATAL_ERROR "${direction}: ID ${id} is in slot ${slot}")
            endif()
            if(size GREATER 0)
                if(NOT layouts MATCHES "CHECK_LAYOUT\\(ExternalMessage::${name}, ([0-9]+),")
                    message(FATAL_ERROR "Missing frozen layout for ${name}")
                endif()
                if(NOT size EQUAL CMAKE_MATCH_1)
                    message(FATAL_ERROR "${name}: emitted size ${size} differs from its frozen wire size ${CMAKE_MATCH_1}")
                endif()
            elseif(NOT size EQUAL -1)
                message(FATAL_ERROR "Invalid flexible packet size ${size}")
            endif()
            list(APPEND actual_${direction} "${direction} ${id} ${size} ${name}")
        endif()
        math(EXPR slot "${slot} + 1")
    endif()
endforeach()
set(actual ${actual_C2S} ${actual_S2C})
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Generated packet identities, sizes or flexible markers differ from the pre-change baseline")
endif()
list(LENGTH actual count)
if(NOT count EQUAL 748)
    message(FATAL_ERROR "Expected 748 named packets, found ${count}")
endif()
message(STATUS "Generator modes, failures, source paths and 2048 packet slots (748 named packets) passed")
