	-- strAI6151
	{ enum = "strAI6151_1", str = "I know a secret passage to [Netherworld Sea Floor Three], but only warriors who have reached Level 35 can pass. Do you want to go?<#SO:1>Send me to [Netherworld Sea Floor Three]<#SO/><#SO:2>Cancel<#SO/>" },
	{ enum = "strAI6151_2", str = "You are still too green. You are below Level 35 and cannot enter for now.<#SO:1>OK<#SO/>"  },


	-- strAI6671
	{ enum = "strAI6671_1", str = "<#D>At the moment I can bundle scrolls and all kinds of potions. Want to bundle? Bundling costs Gold.<#D/><#SO:1>Bundle Regular Potions<#SO/><#SO:2>Bundle Advanced Potions<#SO/><#SO:3>Bundle Scrolls<#SO/>"},
	{ enum = "strAI6671_2", str = "<#D>Please choose the type of advanced potion you want to bundle.<#D/><#SO:1>Bundle Sun Water (200 Gold)<#SO/><#SO:2>Bundle Potent Sun Water (500 Gold)<#SO/><#SO:3>Bundle Healing Potion (1000 Gold)<#SO/><#SO:4>Back<#SO/>"},
	{ enum = "strAI6671_4", str = "<#D>Please choose the type of scroll you want to bundle. Each costs 100 Gold.<#D/><#SO:1>Bundle Bichon Return Scroll<#SO/><#SO:2>Bundle Mongchon Return Scroll<#SO/><#SO:3>Bundle Random Teleport Scroll<#SO/><#SO:4>Back<#SO/>"},
	{ enum = "strAI6671_5", str = "You have reached today's bundling limit. Please come back tomorrow!"},
	{ enum = "strAI6671_6", str = "You are below Level 15 and cannot bundle potions or scrolls!"},


	-- strAI6163
	{ enum = "strAI6163_6_1", str = "Rewards can be claimed from me two hours after the Guild Stronghold War ends."},
	{ enum = "strAI6163_6_2", str = "All members of the guild that successfully captured the stronghold can claim a status reward that raises the EXP rate. Players of Elder rank or above can claim a limited-time title (up to 6).<#D/><#SO:1>Claim Status<#SO/><#SO:2>Claim Title<#SO/>"},
	{ enum = "strAI6163_6_3", str = "Members of guilds that did not capture the stronghold cannot claim rewards."},


	-- strAI_6112
	{ enum = "strAI_6112_1", str = "Any warrior who has reached Level 20 may enter the Nine-Layer Demon Tower for trials. Are you ready, young one?<#SO:1>Confirm Entry<#SO/><#INS:S25>About the Nine-Layer Demon Tower<#INS/><#SO:2>Cancel<#SO/>"},
	
	
	-- strAI_4795
	{ enum = "strAI_4795_1", str = "Every Monday, Wednesday and Friday at 21 o'clock, warriors who have reached Level 22 may enter the Arena for 1 hour. Each entry costs 10000 Gold.<#SO:1>Confirm Entry (costs 10000 Gold)<#SO/><#SO:2>Cancel<#SO/>"},
	
	-- strAI_6101
	{ enum = "strAI_6101_1", str = "Every day at 20 o'clock, warriors who have reached Level 22 may enter the Treasury for 1 hour. Each entry costs 20000 Gold.<#SO:1>Confirm Entry (costs 20000 Gold)<#SO/><#SO:2>Cancel<#SO/>"},

	-- strAI6152
	{ enum = "strAI6152_1", str = "My apologies, warrior. The Training Ground is not open yet. Please look forward to the official announcement for more information!"},
	
	-- strAI6114
	{ enum = "strAI6114_1", str = "You are below Level 20 and cannot enter the Netherworld Sea!"},

	-- strAI6170
	{ enum = "strAI6170_1", str = "Celebrations for all, gifts for everyone! Upon reaching Level 15 you can claim the 'Eternal Gift Pack' here, and upon reaching Level 20 you can claim your class Skill Book. (Please make sure you have enough free Bag slots.)<#SO:1>Claim Eternal Gift Pack<#SO/><#SO:2>Claim Skill Book<#SO/>"},
