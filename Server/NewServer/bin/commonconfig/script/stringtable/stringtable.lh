	-- strAI6147
	{ enum = "strAI6147_1", str = "I know a secret passage to [Death Valley Level Six]. Want to go? Let's all get rich together: give me Gold and I will send you over right away. How about it?<#SO:1>Teleport myself to [Death Valley Level Six]<#SO/><#SO:2>Teleport party to [Death Valley Level Six]<#SO/>" },
	{ enum = "strAI6147_2", str = "[Death Valley Level Six] is full of monsters. Do not go to your death without some real skill. Do you really want to give me 10,000 Gold to send you over?<#SO:1>Confirm: pay 10,000 Gold for solo teleport<#SO/>" },
	{ enum = "strAI6147_3", str = "No money, no deal. Not a single coin of the 10,000 Gold can be missing!" },
	{ enum = "strAI6147_4", str = "[Death Valley Level Six] is full of monsters. Do not go to your death without some real skill. I will teleport every member of your party in the current scene. Do you really want to give me 100,000 Gold to teleport?<#SO:1>Confirm: pay 100,000 Gold for party teleport<#SO/>" },
	{ enum = "strAI6147_5", str = "Don't joke with me, you are not the party leader!" },
	{ enum = "strAI6147_6", str = "No money, no deal. Not a single coin of the 100,000 Gold can be missing!" },


	-- strAI6148
	{ enum = "strAI6148_1", str = "I know a secret passage to [Woma Temple Level Three]. Want to go? Just give me a Woma Token and I will send you over right away. How about it?<#SO:1>Teleport myself to [Woma Temple Level Three]<#SO/><#SO:2>Teleport party to [Woma Temple Level Three]<#SO/>" },
	{ enum = "strAI6148_2", str = "[Woma Temple Level Three] is full of monsters. Do not go to your death without some real skill. Do you really want to give me a [Woma Token (Small)] to send you over?<#SO:1>Submit [Woma Token (Small)] to teleport myself<#SO/>" },
	{ enum = "strAI6148_3", str = "No way, you can't go without a [Woma Token (Small)]!" },
	{ enum = "strAI6148_4", str = "[Woma Temple Level Three] is full of monsters. Do not go to your death without some real skill. I will teleport every member of your party in the current scene. Do you really want to give me a [Woma Token (Large)] to teleport?<#SO:1>Submit [Woma Token (Large)] to teleport party<#SO/>" },
	{ enum = "strAI6148_5", str = "Don't joke with me, you are not the party leader!" },
	{ enum = "strAI6148_6", str = "No way, you can't go without a [Woma Token (Large)]!" },


