	{ enum = "strAI6170_3", str = "You have already claimed the reward. Don't be greedy."},
	{ enum = "strAI6170_4", str = "Claimed successfully. Please check your Bag to confirm."},
	{ enum = "strAI6170_5", str = "Celebrations for all, gifts for everyone! Players who reach Level 15 can claim the 'Eternal Gift Pack' here. (Please make sure you have enough free Bag slots.)<#SO:1>Claim Eternal Gift Pack<#SO/>"},

	-- strAI6171
	{ enum = "strAI6171_1", str = "Players who reach Level 35 can claim one material for every three hours spent online each day. You can also exchange Mentor Righteousness for Belt and Boots recipe scrolls and combine them with materials to craft the matching equipment.<#SO:1>Claim Cotton Thread or Beast Hide<#SO/>"},
	{ enum = "strAI6171_2", str = "You are below Level 35 and cannot claim materials. Please level up and come back."},
	{ enum = "strAI6171_3", str = "You have already claimed materials today. Please come back tomorrow."},
	{ enum = "strAI6171_4", str = "Please choose the material you want to claim and make sure your Bag has enough space.<#SO:1>Claim Cotton Thread<#SO/><#SO:2>Claim Beast Hide<#SO/>"},
	{ enum = "strAI6171_5", str = "Claimed successfully."},
	{ enum = "strAI6171_6", str = "You have not been online for 3 hours yet. Please come back after reaching that."},

