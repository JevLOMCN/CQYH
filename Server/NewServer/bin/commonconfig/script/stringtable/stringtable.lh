	-- 6528 - Mafa courier station 05
	{ enum = "strAI6528_1", str = "I can teleport you to a designated map!<#SO:1>City Teleport<#SO/><#SO:2>Beginner Wilderness<#SO/><#SO:3>Advanced Wilderness<#SO/>"},
	{ enum = "strAI6528_2", str = "City Teleport!<#SO:21>Border Village<#SO/><#SO:22>Mongchon Province<#SO/><#SO:23>Bichon Province<#SO/>"},
	{ enum = "strAI6528_3", str = "Beginner Wilderness!<#SO:31>Woma Forest (Level 8) - 1000 Gold<#SO/><#SO:32>Mining Area Floor One (Level 10) - 1500 Gold<#SO/><#SO:33>Woma Temple (Level 17) - 2000 Gold<#SO/><#SO:34>Death Valley (Level 22) - 2000 Gold<#SO/><#SO:35>Stone Tomb Floor One (Level 25) - 2500 Gold<#SO/>"},
