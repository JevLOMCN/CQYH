	{ enum = "strAI6172_1", str = "I know a secret passage to [Valley Secret Passage]. Want to go? Just give me a Red Moon Token and I will send you over right away. How about it?<#SO:1>Teleport myself to [Valley Secret Passage]<#SO/><#SO:2>Teleport party to [Valley Secret Passage]<#SO/>" },
