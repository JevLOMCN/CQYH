# Build/run logs and crash dumps (UnrealScript make, UE3 engine, wx build)
*.log
*.dmp
Client/client/UE3/MMOGame/Logs/
Client/client/UE3/Intermediate/MMOGameScript/

# Per-user Visual Studio files
*.vcxproj.user
*.suo
*.user

# wxWidgets build output: objects/tlogs/pdbs in build\msw, and everything generated under lib\
# (import libs, .exp/.pdb/.idb, generated setup.h/rcdefs.h). The few tracked placeholders in lib\ stay tracked.
Client/client/UE3/Development/External/wxWidgets/build/msw/vc_*/
Client/client/UE3/Development/External/wxWidgets/lib/vc_dll/
Client/client/UE3/Development/External/wxWidgets/lib/vc_lib/

# Linker/debug side files written next to the engine binaries
Client/client/UE3/Binaries/Win32/*.map
Client/client/UE3/Binaries/Win32/*.ilk
Client/client/UE3/Binaries/Win32/*.exp

# CMake build trees (Visual Studio / Ninja) of the server. Fully generated and contain
# machine-specific absolute paths (repo location, Qt install); each dev runs cmake locally.
Server/build/

# Client: generated or local-run output (not source)
Client/client/UE3/Engine/Shaders/WorkingDirectory/
Client/client/UE3/Development/Intermediate/
Client/client/UE3/Development/Src/Intermediate/
Client/client/UE3/Development/Src/UnrealBuildTool/obj/Debug/
# written by the script compiler (make); regenerated, and only when the compile has zero warnings
Client/client/UE3/MMOGame/Script/Manifest.txt
/Server/NewServer/tools/account_logout/account_logout/.vs
